# Copy to .env and edit. Defaults target Ollama on this machine, no account needed.
# ollama pull qwen2.5:7b
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_API_KEY=ollama
AGENT_MODEL=qwen2.5:7b

# LM Studio (Developer tab -> Start server), then:
# AGENT_BASE_URL=http://localhost:1234/v1
# AGENT_API_KEY=lm-studio
# AGENT_MODEL=<the model id LM Studio shows>

# Azure OpenAI / Microsoft Foundry (OpenAI-compatible v1 endpoint):
# AGENT_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# AGENT_API_KEY=<key>
# AGENT_MODEL=<deployment name>

# Step 17 hybrid routing (optional)
# CLOUD_BASE_URL=
# CLOUD_API_KEY=
# CLOUD_MODEL=
